@namespace Pango.UI.Components

@inject IJSRuntime JS

@typeparam TValue
@using System.Collections
@inherits InputBase<TValue>

<div
  @attributes="AdditionalAttributes"
  data-slot="select"
  aria-disabled="@(Disabled)"
  data-disabled="@(Disabled ? "" : null)"
  class="@Tw(["relative group data-[disabled]:opacity-50", AdditionalAttributes?.GetValueOrDefault("class")?.ToString()])">
  <CascadingValue Value="@this">
    @ChildContent
  </CascadingValue>
</div>

@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public Placements Placement { get; set; } = Placements.BottomCenter;
  [Parameter] public TValue? Default { get; set; }
  [Parameter] public bool Disabled { get; set; }

  public object? Placeholder { get; private set; }

  private TValue? _previousValue;

  protected override void OnInitialized()
  {
    _csSelectRef = DotNetObjectReference.Create(this);
    Placeholder = AdditionalAttributes?.GetValueOrDefault("placeholder");
  }

  protected override void OnParametersSet()
  {
    base.OnParametersSet();

    if (EqualityComparer<TValue>.Default.Equals(Value, _previousValue)) return;

    _previousValue = Value;

    if (Value is not null) return;

    SelectedItem = null;
    SelectValue = null;
    SelectedItems = [];
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      SelectValue = Default is not null
        ? Default
        : AdditionalAttributes?.GetValueOrDefault("placeholder")?.ToString() ?? string.Empty;
      _jsDropdownRender = await JS.InvokeAsync<IJSObjectReference>(
        "import",
        "./Components/Select/Select.razor.js"
      );
    }

    await base.OnAfterRenderAsync(firstRender);
  }

  public async Task OpenSelect()
  {
    Open = true;
    FocusedIndex = 0;

    if (TriggerWidth is null)
    {
      _jsGetElementWidth ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Select/Select.razor.js");
      TriggerWidth = await _jsGetElementWidth.InvokeAsync<float?>("getElementWidth", SelectTriggerRef);
      await InvokeAsync(StateHasChanged);
    }

    if (_jsDropdownRender is not null)
    {
      _jsDropdownCleaner = await _jsDropdownRender.InvokeAsync<IJSObjectReference>("ComputeDialogPosition", SelectTriggerRef,
        SelectContentRef,
        _placements[Placement],
        _csSelectRef,
        nameof(CloseSelect)
      );
    }
  }

  [JSInvokable]
  public async Task CloseSelect()
  {
    Open = false;

    if (_jsDropdownCleaner is not null)
    {
      await _jsDropdownCleaner.InvokeVoidAsync("CleanUpPosition");
    }
  }

  public async Task SelectItem(object? value, SelectItem item)
  {
    if (value is null) return;

    if (CurrentValue is IList list)
    {
      var newList = (IList)Activator.CreateInstance(CurrentValue.GetType())!;
      foreach (var i in list)
      {
        newList.Add(i);
      }

      if (newList.Contains(value))
      {
        newList.Remove(value);
        SelectedItems.Remove(item);
      }
      else
      {
        newList.Add(value);
        SelectedItems.Add(item);
      }

      CurrentValue = (TValue)newList;
      SelectValue = newList.Count > 0 ? newList : null;
    }
    else
    {
      if (Equals(CurrentValue, value))
      {
        CurrentValue = default;
        SelectValue = null;
        SelectedItem = null;
      }
      else
      {
        CurrentValue = (TValue)value;
        SelectValue = value;
        SelectedItem = item;
      }
    }

    await InvokeAsync(StateHasChanged);
  }

}
