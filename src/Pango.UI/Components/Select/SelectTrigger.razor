@namespace Pango.UI.Components

@if (Select is not null)
{
  <button
    type="button"
    role="combobox"
    data-slot="select-trigger"
    aria-expanded="@(Select.Open)"
    aria-autocomplete="none"
    aria-required="@(AdditionalAttributes?.GetValueOrDefault("required")?.ToString())"
    aria-disabled="@(Select.Disabled)"
    data-state="@(Select.Open ? "open" : "closed")"
    data-disabled="@(Select.Disabled ? "" : null)"
    data-size="@(Size.ToString().ToLower())"
    class="@Tw([
             "cursor-pointer whitespace-nowrap max-w-full overflow-hidden border-input data-[placeholder]:text-muted-foreground [&_svg:not([class*='text-'])]:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:bg-input/30 dark:hover:bg-input/50 flex w-fit items-center justify-between gap-2 rounded-md border bg-transparent px-3 py-2 text-sm whitespace-nowrap shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] data-[disabled]:cursor-not-allowed data-[disabled]:dark:hover:bg-transparent data-[disabled]:hover:bg-transparent data-[disabled]:opacity-50 data-[size=default]:h-9 data-[size=sm]:h-8 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-2 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
             AdditionalAttributes?.GetValueOrDefault("class")?.ToString()
           ])"
    @onclick:preventDefault
    @onclick="OnTriggerClick"
    @ref="Select.SelectTriggerRef">
    @ChildContent
    @if (SelectIcon is not null)
    {
      @SelectIcon
    }
    else
    {
      <i class="@Tw(["ph ph-caret-down opacity-50", Size == Sizes.Sm ? "text-sm" : null])"></i>
    }
  </button>
}

@code {

  [CascadingParameter] internal ISelect? Select { get; set; }

  [Parameter(CaptureUnmatchedValues = true)]
  public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public RenderFragment? SelectIcon { get; set; }

  [Parameter] public Sizes Size { get; set; } = Sizes.Default;

  private void OnTriggerClick()
  {
    if (Select is null || Select.Disabled) return;

    Select.OpenSelect();
  }

}
