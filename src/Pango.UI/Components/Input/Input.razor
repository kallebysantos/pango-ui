@using System.Linq.Expressions

@namespace Pango.UI.Components

@inherits InputText

<input
  @attributes="@(AdditionalAttributes)"
  id="@(_id)"
  name="@(_name)"
  readonly=@(ReadOnly)
  @bind="@(CurrentValueAsString)" 
  @bind:event="oninput"
  class=@Tw([
    "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm", 
    "transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground",
    "focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50",
    "aria-[invalid]:ring-1 aria-[invalid]:ring-red-500",
    CssClass,
    AdditionalAttributes?.GetValueOrDefault("class")?.ToString()
  ]) />

@code
{
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    string? _id { get; set; }
    string? _name { get; set; }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);

        if(ReadOnly)
        {
            ValueExpression = () => this.Value;
        }

        await base.SetParametersAsync(parameters);

        _id = AdditionalAttributes?.GetValueOrDefault("id")?.ToString() ?? NameAttributeValue;
        _name = AdditionalAttributes?.GetValueOrDefault("name")?.ToString() ?? NameAttributeValue;

        if(string.IsNullOrEmpty(_id) && !ReadOnly)
        {
          var exp = ValueExpression?.Body as MemberExpression;
          _id = exp?.Member.Name;
        }

        if(string.IsNullOrEmpty(_name))
        {
          _name = _id;
        }
    }
}
