@namespace Pango.UI.Components
@inject IJSRuntime JS

<div
  @attributes="AdditionalAttributes"
  class="@Tw([
           "relative",
           AdditionalAttributes?.GetValueOrDefault("class")?.ToString()
         ])"
  data-state="@State">
  <CascadingValue Value="this">
    @ChildContent
  </CascadingValue>
</div>

@code {
  [Parameter] public string State { get; set; } = "default";

  [Parameter] public RenderFragment? ChildContent { get; set; }

  [Parameter] public Placements Placement { get; set; } = Placements.BottomStart;

  protected override void OnInitialized()
  {
    csDropdownMenuRef = DotNetObjectReference.Create(this);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      jsDropdownRender = await JS.InvokeAsync<IJSObjectReference>(
        "import",
        "./Components/DropdownMenu/DropdownMenu.razor.js"
      );
    }

    await base.OnAfterRenderAsync(firstRender);
  }

  public async Task OpenDropdown()
  {
    State = "open";

    if (jsDropdownRender is not null)
    {
      jsDropdownCleaner = await jsDropdownRender.InvokeAsync<IJSObjectReference>("ComputeDialogPosition", DropdownTriggerRef,
        DropdownContentRef,
        _placements[Placement],
        csDropdownMenuRef,
        nameof(CloseDropdown)
      );
    }
  }

  [JSInvokable]
  public async Task CloseDropdown()
  {
    State = "closed";

    if (jsDropdownCleaner is not null)
    {
      await jsDropdownCleaner.InvokeVoidAsync("CleanUpPosition");
    }
  }

  internal async Task ToggleState()
  {
    switch (State)
    {
      case "open":
        await CloseDropdown();
        break;

      default:
        await OpenDropdown();
        break;
    }
  }

}
