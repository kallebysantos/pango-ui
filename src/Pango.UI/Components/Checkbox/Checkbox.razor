@namespace Pango.UI.Components

@using System.Linq.Expressions

@inherits InputCheckbox

<input
  type="checkbox"
  @attributes="@AdditionalAttributes"
  id="@(_id)"
  name="@(_name)"
  readonly="@(ReadOnly)"
  @bind="@(CurrentValue)"
  @bind:event="onchange"
  indeterminate="@Indeterminate.ToString().ToLower()"
  class=@Tw([
    "appearance-none cursor-pointer text-center text-sm peer ph border border-input dark:bg-input/30 size-4 " +
    "shrink-0 rounded-[4px] shadow-xs transition-shadow focus-visible:border-ring focus-visible:ring-ring/50 " +
    "focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50 not-checked:text-transparent " +
    "checked:text-primary-foreground dark:checked:bg-primary checked:border-primary dark:data-[indeterminate=true]:bg-primary " +
    "data-[indeterminate=true]:border-primary data-[indeterminate=true]:ph-minus data-[indeterminate=true]:text-primary-foreground ",
    Indeterminate ? "ph-minus" : "ph-check",
    CssClass,
    AdditionalAttributes?.GetValueOrDefault("class")?.ToString()
  ])
  @ref="@Element"
/>

@code
{
  [Parameter] public bool ReadOnly { get; set; }
  [Parameter] public bool Indeterminate { get; set; }

  string? _id { get; set; }
  string? _name { get; set; }
  bool _updateIndeterminate;

  public override async Task SetParametersAsync(ParameterView parameters)
  {
    parameters.SetParameterProperties(this);

    if (ReadOnly)
    {
      ValueExpression = () => Value;
    }

    await base.SetParametersAsync(parameters);

    _id = AdditionalAttributes?.GetValueOrDefault("id")?.ToString() ?? NameAttributeValue;
    _name = AdditionalAttributes?.GetValueOrDefault("name")?.ToString() ?? NameAttributeValue;

    if (string.IsNullOrEmpty(_id) && !ReadOnly)
    {
      var exp = ValueExpression?.Body as MemberExpression;
      _id = exp?.Member.Name;
    }

    if (string.IsNullOrEmpty(_name))
    {
      _name = _id;
    }

    _updateIndeterminate = true;
  }
}
