@page "/"

@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@inject IWebAssemblyHostEnvironment Env

<PageTitle>Home</PageTitle>

<div class="flex flex-col gap-4">
  @if (Env.IsDevelopment())
  {
    <NavLink href="/example" class="w-fit">
      <Button Variant=@(Button.Variants.Link)>
        Development Example
      </Button>
    </NavLink>

    <Separator/>
  }

  <nav class="grid grid-cols-1 gap-2 items-center md:grid-flow-col md:grid-rows-2">
    @foreach (var page in GettingStartedPages)
    {
      <NavLink href=@(page.RelativeURI) class="w-fit">
        <Button Variant=@(Button.Variants.Link)>
          @(page.DisplayName)
        </Button>
      </NavLink>
    }
  </nav>

  <Separator/>

  <nav class="grid grid-cols-1 gap-2 items-center md:grid-flow-col md:grid-rows-6">
    @foreach (var page in ComponentsPages.OrderBy(p => p.Name))
    {
      <NavLink href=@(page.RelativeURI) class="w-fit">
        <Button Variant=@(Button.Variants.Link)>
          @(page.DisplayName)
        </Button>
      </NavLink>
    }
  </nav>
</div>

@code {

  private List<QuickLinks.PageDefinition> ComponentsPages =
  [
    new("Alert", "./docs/alert"),
    new("Badge", "./docs/badge"),
    new("Button", "./docs/button"),
    new("Checkbox", "./docs/checkbox"),
    new("Code", "./docs/code"),
    new("DataTable", "./docs/data-table"),
    new("DropdownMenu", "./docs/dropdown-menu"),
    new("Input", "./docs/input"),
    new("Label", "./docs/label"),
    new("Progress", "./docs/progress"),
    new("Separator", "./docs/separator"),
    new("Tabs", "./docs/tabs")
  ];

  private List<QuickLinks.PageDefinition> GettingStartedPages =
  [
    new("Introduction", "./docs/introduction"),
    new("Installation", "./docs/installation"),
    new("Usage", "./docs/usage")
  ];

}
