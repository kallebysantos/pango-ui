
<div class="flex flex-col gap-9 items-center">
  <div class="w-full flex gap-2">
    <Label Value="Nested bind">
      <Input @bind-Value=@(Text) placeholder="Write something here" />
    </Label>
  </div>

  <div class="w-full flex flex-col gap-1">
    <Label htmlFor="profile" Value="External bind" />

    <Input id="profile" @bind-Value=@(Text) placeholder="Enter your message" />
  </div>
</div>

@code {
  string Text = string.Empty;
}
