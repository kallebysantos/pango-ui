@using System.ComponentModel.DataAnnotations

<Dialog>
  <DialogTrigger>
    <Button>Share</Button>
  </DialogTrigger>

  <DialogContent>
    <DialogHeader>
      <DialogTitle>Share link</DialogTitle>
      <DialogDescription>Anyone who has this link will be able to view this.</DialogDescription>
    </DialogHeader>

    <Input Value="https://github.com/kallebysantos/pango-ui" autofocus ReadOnly />

    <DialogClose>
      <Button Variant="@(Button.Variants.Outline)">
        Close
      </Button>
    </DialogClose>
  </DialogContent>
</Dialog>

